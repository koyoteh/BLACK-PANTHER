# Existing deployment settings. Do not commit a real .env file or session.
MODE=private
PREFIXES=.
PORT=3000

# Use either session variable. SESSION is base64(creds.json).
# SESSION_ID may be GURU~base64(gzip(creds.json)) from the current bot,
# or the same base64(creds.json) format accepted by SESSION.
SESSION=
SESSION_ID=

TZ=Africa/Nairobi
# Legacy variable accepted when TZ is not set:
TIME_ZONE=Africa/Nairobi

ANTICALL=off
ANTIDELETE=on
ANTIEDIT=on
AUTO_READ=off
AUTO_REACT=off
# AUTO_REACT_MODE=all, groups, or dm; set AUTO_REACT=on to enable.
AUTO_REACT_MODE=all
# Optional comma-separated reaction emoji list.
AUTO_REACT_EMOJIS=🐾,⚡,💜
AUTO_VIEW=on
AUTO_LIKE=on
# Legacy status settings are also accepted:
AUTO_READ_STATUS=true
AUTO_LIKE_STATUS=true

DM_PRESENCE=
GRP_PRESENCE=
USER_LID=

OWNER_NUMBER=
OWNER_NAME=Black Panther
BOT_NAME=Black Panther
BOT_PIC=https://raw.githubusercontent.com/cleanplata/BLACK-PANTHER/main/assets/black-panther.jpg
MENU_IMAGES=

CHANNEL_JID=120363431857319034@newsletter
CHANNEL_URL=https://whatsapp.com/channel/0029VbDh88NCMY0Fartkxm1g
HOSTING_URL=https://cheap.bothosting.gurutech.top
HOSTING_PROVIDER=Bothosting
GITHUB_REPO=cleanplata/BLACK-PANTHER

