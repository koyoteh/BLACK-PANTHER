[Unit]
Description=Tehseen Tech Automation WhatsApp Bot
After=network.target

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/tehseen-bot
ExecStart=/usr/bin/node --expose-gc --max-old-space-size=512 index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=5000
EnvironmentFile=-/opt/tehseen-bot/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tehseen-bot

[Install]
WantedBy=multi-user.target
